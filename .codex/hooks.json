{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/scripts/sync-session-logs.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
