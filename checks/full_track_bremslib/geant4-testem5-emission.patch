@@ -59,6 +65,34 @@ void SteppingAction::UserSteppingAction(const G4Step* aStep)
     fEventAction->AddTrakLenNeutr(aStep->GetStepLength());
     fEventAction->CountStepsNeutr(aStep->GetPostStepPoint()->GetProcessDefinedStep());
   }
+
+  // Issue #182: score the primary track-length spectrum and log each primary
+  // eBrem emission with the post-step primary state; the pre-emission
+  // direction is reconstructed offline.
+  if (aStep->GetTrack()->GetTrackID() != 1) return;
+  const G4VProcess* process = aStep->GetPostStepPoint()->GetProcessDefinedStep();
+  const G4bool brem = process != nullptr && process->GetProcessName() == "eBrem";
+  const G4double after = aStep->GetPostStepPoint()->GetKineticEnergy();
+  G4double discrete = 0.;
+  if (brem) {
+    for (const G4Track* secondary : *aStep->GetSecondaryInCurrentStep()) {
+      if (secondary->GetCreatorProcess() == process) discrete += secondary->GetKineticEnergy();
+    }
+  }
+  const G4double before = aStep->GetPreStepPoint()->GetKineticEnergy();
+  G4AnalysisManager::Instance()->FillH1(
+    63, 0.5 * (before + after + discrete), aStep->GetStepLength() / um);
+  if (!brem) return;
+  const G4int event = G4EventManager::GetEventManager()->GetConstCurrentEvent()->GetEventID();
+  const G4ThreeVector u = aStep->GetPostStepPoint()->GetMomentumDirection();
+  for (const G4Track* secondary : *aStep->GetSecondaryInCurrentStep()) {
+    if (secondary->GetCreatorProcess() != process) continue;
+    const G4ThreeVector n = secondary->GetMomentumDirection();
+    G4cout << std::setprecision(17) << "EBREM " << event << ' ' << after / eV << ' '
+           << secondary->GetKineticEnergy() / eV << ' ' << u.x() << ' ' << u.y() << ' '
+           << u.z() << ' ' << n.x() << ' ' << n.y() << ' ' << n.z() << std::setprecision(6)
+           << G4endl;
+  }
 }
 
