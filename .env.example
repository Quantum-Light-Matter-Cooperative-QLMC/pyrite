export WORKTREES='$HOME/dev/wt/pyrite/'

export PYRITE_MC_BACKEND='cpu'

export PYRITE_ONLINE_TESTS=0
export PYRITE_RUN_INTEL_SYCL_TESTS=0

export MP_API_KEY='<YOUR_API_KEY>'

# pixi environment per backend
case "$PYRITE_MC_BACKEND" in
cuda) PIXI_ENV=nvidia ;;
rocm) PIXI_ENV=amd ;;
sycl) PIXI_ENV=intel ;;
*) PIXI_ENV=default ;;
esac

watch_file pixi.lock pyproject.toml
eval "$(pixi shell-hook --locked -e "$PIXI_ENV")"
unset PIXI_ENV
