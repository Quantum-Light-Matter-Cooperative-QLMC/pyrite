{
  "permissions": {
    "allow": [
      "Bash(rtk env UV_CACHE_DIR=/tmp/cxr-mc-uv-cache uv run python scripts/dev.py:*)",
      "Bash(rtk env UV_CACHE_DIR=/tmp/cxr-mc-uv-cache uv run cxr:*)",
      "Bash(rtk env UV_CACHE_DIR=/tmp/cxr-mc-uv-cache uv run marimo:*)",
      "Bash(rtk git diff:*)",
      "Bash(rtk git status:*)",
      "Bash(rtk git add:*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "rtk env UV_CACHE_DIR=/tmp/cxr-mc-uv-cache uv sync --all-groups --extra viz-render"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && f=.venv/Scripts/python.exe; [ -x \"$f\" ] || f=.venv/bin/python; [ -x \"$f\" ] || f=python3; \"$f\" .claude/hooks/guard_local_sweep.py",
            "statusMessage": "Checking for local sweep"
          }
        ]
      }
    ]
  }
}
