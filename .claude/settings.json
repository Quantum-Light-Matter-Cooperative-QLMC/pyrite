{
  "permissions": {
    "allow": [
      "Bash(uv run python scripts/dev.py:*)",
      "Bash(uv run cxr:*)",
      "Bash(uv run marimo:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "f=.venv/Scripts/python.exe; [ -x \"$f\" ] || f=.venv/bin/python; \"$f\" .claude/hooks/on_edit.py 2>/dev/null || true",
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ]
  }
}
