{
  "permissions": {
    "allow": [
      "Bash(rtk env UV_CACHE_DIR=/tmp/cxr-mc-uv-cache uv run python scripts/dev.py:*)",
      "Bash(rtk env UV_CACHE_DIR=/tmp/cxr-mc-uv-cache uv run cxr:*)",
      "Bash(rtk env UV_CACHE_DIR=/tmp/cxr-mc-uv-cache uv run marimo:*)",
      "Bash(rtk git diff:*)",
      "Bash(rtk git status:*)",
      "Bash(rtk git add:*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "f=.venv/Scripts/python.exe; [ -x \"$f\" ] || f=.venv/bin/python; \"$f\" .claude/hooks/guard_local_sweep.py",
            "statusMessage": "Checking for local sweep"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "f=.venv/Scripts/python.exe; [ -x \"$f\" ] || f=.venv/bin/python; \"$f\" .claude/hooks/on_edit.py 2>/dev/null || true",
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ]
  }
}
