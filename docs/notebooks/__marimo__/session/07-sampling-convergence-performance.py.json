          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"adaptive-stopping\">Adaptive stopping</h2>\n<span class=\"paragraph\"><code>AdaptiveSampling</code> estimates a batch-means relative standard error\n(RSE), subject to minimum-sample and contribution guards. It can reach\nits history limit <strong>without meeting the target</strong>. The deliberately\nloose RSE target here is for teaching.</span></span>"
          }
        }
      ],
      "console": []
