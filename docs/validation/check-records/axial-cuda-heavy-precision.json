 "batch_script": "#!/bin/bash\n#SBATCH --job-name=623-qcuda\n#SBATCH --partition=gpu\n#SBATCH --gres=gpu:1\n#SBATCH --cpus-per-task=8\n#SBATCH --mem=24G\n#SBATCH --time=01:30:00\n#SBATCH --output=/home/aamador/pyrite-623-quantum-cuda/qcuda-%j.log\n# Stages run sequentially on one GPU; a failing stage is recorded and later stages still run.\nset -u\ncd /home/aamador/pyrite-623-quantum-cuda\nUV=/home/aamador/.local/bin/uv\nexport OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8\nout=pyrite-output/research/issue623/quantum-cuda-20261021\nmkdir -p \"$out\"\ntest ! -e \"$out/status.txt\" || { echo \"refusing to overwrite $out\"; exit 2; }\ncp .pyrite-sync \"$out/code-identity.txt\"\ncp \"$0\" \"$out/run.sh\"\nsha256sum checks/axial_mcwf_cuda.py checks/axial_split_step_precision_cuda.py src/pyrite/montecarlo/channeling/_axial_cuda*.py src/pyrite/montecarlo/channeling/axial_mcwf.py > \"$out/source-sha256.txt\"\nnvidia-smi --query-gpu=name,memory.total,driver_version,compute_cap,clocks.max.sm --format=csv > \"$out/gpu.txt\"\n$UV run --no-sync python -c 'import sys,numpy,scipy,cupy; print(sys.version); print(\"numpy\",numpy.__version__); print(\"scipy\",scipy.__version__); print(\"cupy\",cupy.__version__, cupy.cuda.runtime.runtimeGetVersion())' > \"$out/environment.txt\"\nstage() {\n  name=$1; shift\n  start=$(date +%s)\n  /usr/bin/time -v -o \"$out/$name.resources.txt\" \"$@\" > \"$out/$name.out\" 2> \"$out/$name.err\"\n  code=$?\n  echo \"$name exit=$code seconds=$(( $(date +%s) - start ))\" | tee -a \"$out/status.txt\"\n}\n# 1. Functional: every quantum/channeling CUDA test module, serial, slow included, skips reported.\nPYRITE_TEST_WORKERS=1 stage tests $UV run --no-sync pyrite-dev test --slow \\\n  tests/montecarlo/test_channeling_axial_cuda.py tests/montecarlo/test_channeling_cuda.py \\\n  tests/montecarlo/test_axial_flux.py tests/montecarlo/test_axial_flux_integration.py \\\n  tests/montecarlo/test_channeling_axial_energy_mcwf.py -rs -v\n# 2. Reproduce the recorded 1 MeV hardware-target workloads.\nstage bench-default $UV run --no-sync python checks/axial_mcwf_cuda.py\n# 3. Heavy 5 MeV supercell workloads; CPU capped at 64 electrons, throughput compared per electron-step.\nstage bench-heavy $UV run --no-sync python checks/axial_mcwf_cuda.py --energy-eV 5e6 \\\n  --cpu-max-electrons 64 --repeats 2 \\\n  --workload 1,48,512,10000 --workload 2,32,512,10000 \\\n  --workload 3,32,512,10000 --workload 4,32,1024,10000\n# 4. FP32/FP64 tolerance and throughput of the no-jump split step to 10 um.\nstage precision $UV run --no-sync python checks/axial_split_step_precision_cuda.py \\\n  --out \"$out/precision.json\"\n",
