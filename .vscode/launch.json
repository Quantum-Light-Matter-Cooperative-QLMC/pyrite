{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "General Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug trace_app (marimo)",
            "type": "debugpy",
            "request": "launch",
            "module": "marimo",
            "args": [
                "run",
                "${workspaceFolder}/src/cxr_mc/apps/trace_app.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "Debug scan_app (marimo)",
            "type": "debugpy",
            "request": "launch",
            "module": "marimo",
            "args": [
                "run",
                "${workspaceFolder}/src/cxr_mc/apps/scan_app.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "Debug analysis_app (marimo)",
            "type": "debugpy",
            "request": "launch",
            "module": "marimo",
            "args": [
                "run",
                "${workspaceFolder}/src/cxr_mc/apps/analysis_app.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "Debug validation_app (marimo)",
            "type": "debugpy",
            "request": "launch",
            "module": "marimo",
            "args": [
                "run",
                "${workspaceFolder}/src/cxr_mc/apps/validation_app.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        },
    ]
}
