{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pyrite: all tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "preLaunchTask": "uv: sync all groups"
        },
        {
            "name": "DEBUG: pytest single-process, no JIT",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-n",
                "0",
                "-s",
                "-vv",
                "${file}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "stopOnEntry": true,
            "env": {
                "NUMBA_DISABLE_JIT": "1"
            },
            "preLaunchTask": "uv: sync all groups"
        },
        {
            "name": "Pyrite: current test file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-vv"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "preLaunchTask": "uv: sync all groups"
        },
        {
            "name": "Debug trace_app (marimo)",
            "type": "debugpy",
            "request": "launch",
            "module": "marimo",
            "args": [
                "run",
                "${workspaceFolder}/src/pyrite/apps/trace_app.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true,
            "preLaunchTask": "uv: sync all groups"
        },
        {
            "name": "Debug scan_app (marimo)",
            "type": "debugpy",
            "request": "launch",
            "module": "marimo",
            "args": [
                "run",
                "${workspaceFolder}/src/pyrite/apps/scan_app.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true,
            "preLaunchTask": "uv: sync all groups"
        },
        {
            "name": "Debug analysis_app (marimo)",
            "type": "debugpy",
            "request": "launch",
            "module": "marimo",
            "args": [
                "run",
                "${workspaceFolder}/src/pyrite/apps/analysis_app.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true,
            "preLaunchTask": "uv: sync all groups"
        },
        {
            "name": "Debug validation_app (marimo)",
            "type": "debugpy",
            "request": "launch",
            "module": "marimo",
            "args": [
                "run",
                "${workspaceFolder}/src/pyrite/apps/validation_app.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true,
            "preLaunchTask": "uv: sync all groups"
        },
    ]
}
