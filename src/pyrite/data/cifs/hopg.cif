data_hopg
# Phase identity: PyRITE crystal catalog entry [hopg].
# Bundled full-basis P1 CIF used by the declarative material catalog.
# Catalog provenance and assumptions:
# AB-stacked (Bernal) highly-oriented pyrolytic graphite, 4 atoms per cell.
# mosaic_fwhm_deg: c-axis (00l) rocking-curve FWHM of the mosaic-block spread.
# 0.8 deg = ZYB research grade (ZYA 0.4 / ZYB 0.8 / ZYH 3.5). OPTIONAL per crystal:
# omit it for near-perfect crystals (diamond, silicon) -> treated as perfect. Only
# applied when a run sets Sweep(mosaic=True); see sweep.build_cases / montecarlo.mosaic_fwhm_eV.
# mosaic_fwhm_deg = 0.8
_symmetry_space_group_name_H-M 'P 1'
_symmetry_Int_Tables_number 1
_cell_length_a 2.461
_cell_length_b 2.461
_cell_length_c 6.711
_cell_angle_alpha 90.0
_cell_angle_beta 90.0
_cell_angle_gamma 120.0
