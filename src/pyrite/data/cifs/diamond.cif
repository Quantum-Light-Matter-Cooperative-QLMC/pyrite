data_diamond
# Phase identity: PyRITE crystal catalog entry [diamond].
# Bundled full-basis P1 CIF used by the declarative material catalog.
# Catalog provenance and assumptions:
# Crystal structure database for pyrite.validation.feranchuk_spence
#
# Each table is one crystal:
#   system        : "cubic" | "hexagonal" | "tetragonal" | "orthorhombic" | "general"
#   a, b, c       : lattice constants [Angstrom] (which are required depends on system)
#   alpha/beta/gamma : cell angles in DEGREES (system = "general" only)
#   basis         : atoms in the conventional cell as { element, pos } with
#                   pos = fractional coordinates [x/a, y/b, z/c]
#
# The cell volume is computed from the lattice by the loader; it is not stored here.
_symmetry_space_group_name_H-M 'P 1'
_symmetry_Int_Tables_number 1
_cell_length_a 3.5668
_cell_length_b 3.5668
_cell_length_c 3.5668
_cell_angle_alpha 90.0
_cell_angle_beta 90.0
_cell_angle_gamma 90.0
