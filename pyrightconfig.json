{
  "include": ["src"],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "checkpoints",
    "results",
    "docs/_build",
    "docs/_autosummary",
    "**/node_modules",
    "**/.*",
  ],
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "pythonVersion": "3.13",
  "reportMissingTypeStubs": "none"
}
